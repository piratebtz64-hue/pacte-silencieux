# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role (Backend only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database URLs
DATABASE_URL=postgresql://user:password@localhost:5432/pacte_silencieux
DIRECT_URL=postgresql://user:password@localhost:5432/pacte_silencieux

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Optional - for donations)
NEXT_PUBLIC_STRIPE_DONATION_LINK=https://buy.stripe.com/your_stripe_link

# Node Environment
NODE_ENV=development
